{
  "name": "BugReport",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bug_report",
        "feature_request"
      ],
      "default": "bug_report"
    },
    "provider": {
      "type": "string"
    },
    "page_url": {
      "type": "string"
    },
    "screenshot_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "wont_fix"
      ],
      "default": "open"
    }
  },
  "required": [
    "description"
  ]
}