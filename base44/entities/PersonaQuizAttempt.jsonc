{
  "name": "PersonaQuizAttempt",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "marketing_consent": {
      "type": "boolean",
      "default": false
    },
    "brand_view": {
      "type": "string",
      "enum": [
        "personal",
        "corporate",
        "one_and_the_same"
      ],
      "default": "personal"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "scores": {
      "type": "object"
    },
    "primary_archetype": {
      "type": "string"
    },
    "primary_score": {
      "type": "number"
    },
    "secondary_archetype": {
      "type": "string"
    },
    "secondary_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "claimed"
      ],
      "default": "claimed"
    },
    "token_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}