{
  "name": "PortalContent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "file",
        "drive_link",
        "custom_section"
      ],
      "default": "note"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "target_page": {
      "type": "string",
      "default": "overview"
    },
    "drive_folder_id": {
      "type": "string"
    },
    "drive_folder_name": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "target_page"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}