{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "to": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "template_key": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "default": "resend"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "failed",
        "bounced",
        "complained",
        "delivered",
        "delayed",
        "opened",
        "clicked"
      ],
      "default": "queued"
    },
    "resend_message_id": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "related_entity": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "to",
    "template_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}