{
  "name": "LeverageOpportunity",
  "type": "object",
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "agency_client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "demand_capture",
        "borrowed_trust",
        "proof_multipliers",
        "audience_access",
        "retention_loops",
        "category_creation",
        "operational_advantage",
        "asset_repurposing"
      ]
    },
    "description": {
      "type": "string"
    },
    "related_channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_journey_stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "effort": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "time_to_impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "required_resources": {
      "type": "string"
    },
    "prerequisites": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "explore",
        "test",
        "build",
        "defer",
        "not_applicable"
      ],
      "default": "explore"
    },
    "internal_notes": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "client_summary": {
      "type": "string"
    },
    "related_action_item": {
      "type": "string"
    },
    "related_service": {
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}