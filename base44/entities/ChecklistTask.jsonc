{
  "name": "ChecklistTask",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "deadline_date": {
      "type": "string",
      "format": "date"
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "1_month",
        "3_months",
        "6_months",
        "none"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "parent_id": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "source_workbook_title": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}