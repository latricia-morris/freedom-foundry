{
  "name": "VisibilityReport",
  "type": "object",
  "properties": {
    "agency_client_id": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "is_baseline": {
      "type": "boolean",
      "default": false
    },
    "access_tier": {
      "type": "string",
      "enum": [
        "prospect",
        "client"
      ],
      "default": "prospect"
    },
    "composite_score": {
      "type": "number"
    },
    "category_scores": {
      "type": "object",
      "properties": {
        "entity_recognition": {
          "type": "number"
        },
        "structured_data": {
          "type": "number"
        },
        "trusted_source_citations": {
          "type": "number"
        },
        "topical_authority": {
          "type": "number"
        },
        "documented_outcomes": {
          "type": "number"
        },
        "social_channel_presence": {
          "type": "number"
        },
        "off_site_category_authority": {
          "type": "number"
        }
      }
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions_client_visible": {
      "type": "boolean",
      "default": false
    },
    "audit_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "methodology": {
            "type": "string",
            "enum": [
              "measured",
              "observed",
              "requires_self_test",
              "mixed",
              "none"
            ],
            "default": "none"
          },
          "body": {
            "type": "string"
          },
          "table": {
            "type": "object",
            "properties": {
              "header": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "client_visible": {
            "type": "boolean",
            "default": true
          },
          "release_with_recommendations": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "social_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "followers": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "platform"
        ]
      }
    },
    "business_snapshot": {
      "type": "object",
      "properties": {
        "email_platform": {
          "type": "string"
        },
        "email_frequency": {
          "type": "string"
        },
        "marketing_blasts": {
          "type": "string"
        },
        "drip_campaigns": {
          "type": "string"
        },
        "funnel_assets": {
          "type": "string"
        },
        "events_launches": {
          "type": "string"
        }
      }
    },
    "marketing_allocation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string"
          },
          "percent": {
            "type": "number"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "area",
          "percent"
        ]
      }
    },
    "competitor_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "positioning": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "analyst_notes": {
      "type": "string"
    },
    "next_checkin_date": {
      "type": "string",
      "format": "date"
    },
    "raw_input_text": {
      "type": "string"
    },
    "input_method": {
      "type": "string",
      "enum": [
        "paste",
        "upload"
      ],
      "default": "paste"
    },
    "source_model": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "human_reviewed"
      ],
      "default": "pending_review"
    }
  },
  "required": [
    "agency_client_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}