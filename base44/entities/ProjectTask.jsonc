{
  "name": "ProjectTask",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "internal_owner": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "client_due_date": {
      "type": "string",
      "format": "date"
    },
    "internal_ready_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "scheduled",
        "waiting_on_client",
        "in_production",
        "internal_review",
        "ready_for_client_review",
        "client_review_in_progress",
        "revisions_requested",
        "client_approved",
        "awaiting_payment_release",
        "released",
        "blocked",
        "on_hold",
        "completed"
      ],
      "default": "not_started"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "blocked_by_client_reason": {
      "type": "string"
    },
    "linked_line_item_id": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}