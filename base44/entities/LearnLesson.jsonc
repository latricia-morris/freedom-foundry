{
  "name": "LearnLesson",
  "type": "object",
  "properties": {
    "offering_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "video_file_uri": {
      "type": "string"
    },
    "video_file_name": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "audio_file_uri": {
      "type": "string"
    },
    "audio_file_name": {
      "type": "string"
    },
    "embed_code": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          }
        }
      }
    },
    "worksheet": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "prompt_template": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "red"
      ],
      "default": "draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "offering_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}