{
  "name": "PortfolioAsset",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "default": "other"
    },
    "file_url": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "allow_download": {
      "type": "boolean",
      "default": false
    },
    "alt_text": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "original_filename": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}