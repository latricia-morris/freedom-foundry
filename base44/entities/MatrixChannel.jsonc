{
  "name": "MatrixChannel",
  "type": "object",
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "agency_client_id": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "strategic_fit": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "maturity": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "buyer_impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "time_to_impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "investment_required": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "execution_confidence": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "measurement_readiness": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "strategic_role": {
      "type": "string",
      "enum": [
        "primary_growth_channel",
        "supporting_channel",
        "trust_building_channel",
        "nurture_channel",
        "conversion_channel",
        "retention_referral_channel",
        "experiment",
        "deprioritize",
        "not_applicable"
      ]
    },
    "consultant_priority": {
      "type": "string",
      "enum": [
        "build",
        "scale",
        "optimize",
        "maintain",
        "test",
        "deprioritize",
        "not_applicable"
      ],
      "default": "build"
    },
    "journey_stage": {
      "type": "string",
      "enum": [
        "trigger",
        "discovery",
        "evaluation",
        "decision",
        "retention_referral"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "client_notes": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": false
    },
    "related_action_item": {
      "type": "string"
    },
    "related_service": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "audit_id",
    "channel_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}