    "matrix_weights": {
      "type": "object",
      "properties": {
        "channel_fit": {
          "type": "number",
          "default": 35
        },
        "journey_coverage": {
          "type": "number",
          "default": 25
        },
        "channel_integration": {
          "type": "number",
          "default": 25
        },
        "execution_readiness": {
          "type": "number",
          "default": 15
        },
        "customer_growth_readiness": {
          "type": "number",
          "default": 0
        }
      }
    },
    "mai_label": {
      "type": "string",
      "default": "Market Alignment Index"
    },
    "mai_visible": {
      "type": "boolean",
      "default": false
    },
    "journey_weights": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "number",
          "default": 10
        },
        "discovery": {
          "type": "number",
          "default": 25
        },
        "evaluation": {
          "type": "number",
          "default": 25
        },
        "decision": {
          "type": "number",
          "default": 25
        },
        "retention_referral": {
          "type": "number",
          "default": 15
        }
      }
    },
    "journey_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "trigger",
              "discovery",
              "evaluation",
              "decision",
              "retention_referral"
            ]
          },
          "coverage": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "strong",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "internal_notes": {
            "type": "string"
          },
          "client_notes": {
            "type": "string"
          },
          "client_visible": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "stage"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "file",
              "url",
              "evidence_link"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "internal_only": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "title",
          "url"
        ]
      }
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "published_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "agency_client_id",
    "component"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}