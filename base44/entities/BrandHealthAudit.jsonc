{
  "name": "BrandHealthAudit",
  "type": "object",
  "properties": {
    "agency_client_id": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "enum": [
        "website_discoverability",
        "conversion_readiness",
        "marketing_matrix"
      ]
    },
    "package_tier": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "intake_received",
        "scheduled",
        "in_review",
        "draft_complete",
        "awaiting_consultant_review",
        "published_to_client",
        "archived"
      ],
      "default": "requested"
    },
    "intake_received_date": {
      "type": "string",
      "format": "date"
    },
    "intake_data": {
      "type": "object",
      "additionalProperties": true
    },
    "review_scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "info_requested_note": {
      "type": "string"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "client_intake",
        "consultant_loaded",
        "mixed"
      ],
      "default": "client_intake"
    },
    "findings_loaded": {
      "type": "boolean",
      "default": false
    },
    "client_intake_complete": {
      "type": "boolean",
      "default": false
    },
    "minimum_baseline_met": {
      "type": "boolean",
      "default": false
    },
    "matrix_ready": {
      "type": "boolean",
      "default": false
    },
    "matrix_state": {
      "type": "string",
      "enum": [
        "awaiting_intake",
        "baseline_gap",
        "ready_for_review",
        "results_available"
      ],
      "default": "awaiting_intake"
    },
    "client_can_edit": {
      "type": "boolean",
      "default": false
    },
    "missing_baseline_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_industry": {
      "type": "string"
    },
    "baseline_offer_type": {
      "type": "string"
    },
    "baseline_positioning": {
      "type": "string"
    },
    "baseline_visibility": {
      "type": "string"
    },
    "baseline_credibility": {
      "type": "string"
    },
    "baseline_consistency": {
      "type": "string"
    },
    "baseline_growth_priority": {
      "type": "string"
    },
    "baseline_competitive_advantage": {
      "type": "string"
    },
    "consultant_findings_summary": {
      "type": "string"
    },
    "consultant_findings_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "matrix_results_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "results_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_by": {
      "type": "string"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number"
    },
    "show_subscores": {
      "type": "boolean",
      "default": true
    },
    "subscores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "consultant_summary": {
      "type": "string"
    },
    "action_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "opportunity"
            ],
            "default": "medium"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "done"
            ],
            "default": "open"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "matrix_scores": {
      "type": "object",
      "properties": {
        "channel_fit": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "client_label": {
              "type": "string"
            },
            "client_visible": {
              "type": "boolean",
              "default": false
            },
            "summary": {
              "type": "string"
            },
            "measures": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "interpretation": {
              "type": "string"
            },
            "implication": {
              "type": "string"
            },
            "constraint": {
              "type": "string"
            },
            "priorities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "success_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "internal_notes": {
              "type": "string"
            },
            "last_reviewed": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "journey_coverage": {
          "type": "object",
          "properties": {
            "score": {
