{
  "name": "BrandHealthAudit",
  "type": "object",
  "properties": {
    "agency_client_id": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "enum": [
        "website_discoverability",
        "conversion_readiness",
        "marketing_matrix"
      ]
    },
    "package_tier": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "intake_received",
        "scheduled",
        "in_review",
        "draft_complete",
        "awaiting_consultant_review",
        "published_to_client",
        "archived"
      ],
      "default": "requested"
    },
    "intake_received_date": {
      "type": "string",
      "format": "date"
    },
    "intake_data": {
      "type": "object",
      "additionalProperties": true
    },
    "review_scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "info_requested_note": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "show_subscores": {
      "type": "boolean",
      "default": true
    },
    "subscores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "consultant_summary": {
      "type": "string"
    },
    "action_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "opportunity"
            ],
            "default": "medium"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "done"
            ],
            "default": "open"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "matrix_scores": {
      "type": "object",
      "properties": {
        "channel_fit": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "client_label": {
              "type": "string"
            },
            "client_visible": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "journey_coverage": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "client_label": {
              "type": "string"
            },
            "client_visible": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "channel_integration": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "client_label": {
              "type": "string"
            },
            "client_visible": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "execution_readiness": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "client_label": {
              "type": "string"
            },
            "client_visible": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "matrix_weights": {
      "type": "object",
      "properties": {
        "channel_fit": {
          "type": "number",
          "default": 35
        },
        "journey_coverage": {
          "type": "number",
          "default": 25
        },
        "channel_integration": {
          "type": "number",
          "default": 25
        },
        "execution_readiness": {
          "type": "number",
          "default": 15
        }
      }
    },
    "mai_label": {
      "type": "string",
      "default": "Market Alignment Index"
    },
    "mai_visible": {
      "type": "boolean",
      "default": false
    },
    "journey_weights": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "number",
          "default": 10
        },
        "discovery": {
          "type": "number",
          "default": 25
        },
        "evaluation": {
          "type": "number",
          "default": 25
        },
        "decision": {
          "type": "number",
          "default": 25
        },
        "retention_referral": {
          "type": "number",
          "default": 15
        }
      }
    },
    "journey_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "trigger",
              "discovery",
              "evaluation",
              "decision",
              "retention_referral"
            ]
          },
          "coverage": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "strong",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "internal_notes": {
            "type": "string"
          },
          "client_notes": {
            "type": "string"
          },
          "client_visible": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "stage"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "file",
              "url",
              "evidence_link"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "internal_only": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "title",
          "url"
        ]
      }
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "published_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "agency_client_id",
    "component"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}