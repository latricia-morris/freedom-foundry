{
  "name": "ProposalLineItem",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "tier",
        "quantity_based"
      ],
      "default": "required"
    },
    "tier_group": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "unit_price_cents": {
      "type": "number",
      "default": 0
    },
    "default_quantity": {
      "type": "number",
      "default": 1
    },
    "quantity_min": {
      "type": "number",
      "default": 1
    },
    "quantity_max": {
      "type": "number"
    },
    "quantity_label": {
      "type": "string"
    },
    "client_selectable": {
      "type": "boolean",
      "default": true
    },
    "pricing_visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "proposal_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}