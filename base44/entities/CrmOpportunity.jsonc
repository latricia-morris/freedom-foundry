{
  "name": "CrmOpportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "agency_client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "stage": {
      "type": "string",
      "enum": [
        "lead",
        "qualified",
        "proposal",
        "negotiation",
        "won",
        "lost"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "yellow",
        "green",
        "red"
      ],
      "default": "lead"
    },
    "probability": {
      "type": "number",
      "default": 10
    },
    "expected_close_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}