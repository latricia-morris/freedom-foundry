{
  "name": "IgniteTask",
  "type": "object",
  "properties": {
    "list_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Drafting",
        "Brand Review",
        "Approved",
        "Live"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "green"
      ],
      "default": "Drafting"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "assignee_email": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "default_assignee_role": {
      "type": "string"
    },
    "rolling_day_offset": {
      "type": "number"
    },
    "strategic_outcome": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "submitted_for_review_at": {
      "type": "string"
    },
    "subtasks": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "subtask_id": {
            "type": "string"
          },
          "subtask_title": {
            "type": "string"
          },
          "is_completed": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "subtask_id",
          "subtask_title"
        ]
      }
    }
  },
  "required": [
    "list_id",
    "title"
  ]
}