{
  "name": "ServiceRequestSubmission",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Branding",
        "Graphic Design",
        "Software & Assets"
      ],
      "default": "Branding"
    },
    "submission_data": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_progress",
        "scheduled",
        "completed"
      ],
      "default": "submitted"
    }
  },
  "required": [
    "service_type"
  ]
}