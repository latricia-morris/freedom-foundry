{
  "name": "ServiceRequestSubmission",
  "type": "object",
  "properties": {
    "request_kind": {
      "type": "string",
      "default": "service_hub"
    },
    "category_key": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "default": "Branding"
    },
    "client_status": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "save_for_later",
        "in_progress",
        "scheduled",
        "completed"
      ],
      "default": "submitted"
    },
    "save_for_later": {
      "type": "boolean",
      "default": false
    },
    "answers": {
      "type": "object"
    },
    "details": {
      "type": "object"
    },
    "user_id": {
      "type": "string"
    },
    "submission_data": {
      "type": "object"
    },
    "project_type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "inspiration_file_uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deposit_acknowledged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "service_type"
  ]
}