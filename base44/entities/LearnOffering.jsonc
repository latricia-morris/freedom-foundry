{
  "name": "LearnOffering",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "course",
        "book",
        "resource"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow"
      ],
      "default": "course"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "description": "Label for a standalone resource, e.g. Download or Digital Workbook"
    },
    "link_url": {
      "type": "string",
      "description": "Where a standalone resource opens: an in-app path or an https link"
    },
    "vault_item_id": {
      "type": "string",
      "description": "The Vault item this was migrated from"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "video_file_uri": {
      "type": "string"
    },
    "video_file_name": {
      "type": "string"
    },
    "embed_code": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "red"
      ],
      "default": "draft"
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "price_cents": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "stripe_product_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "stripe_price_cents": {
      "type": "number"
    },
    "stripe_synced_at": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}