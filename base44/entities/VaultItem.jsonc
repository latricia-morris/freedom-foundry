{
  "name": "VaultItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Course",
        "Toolkit",
        "Digital Workbook",
        "Download",
        "Software",
        "AI",
        "Affiliate"
      ],
      "default": "Course"
    },
    "featured_image_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ],
      "default": "draft"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "access_code": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type"
  ]
}