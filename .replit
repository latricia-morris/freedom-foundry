modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[userenv]

[userenv.shared]
LEAD_ADMIN_EMAIL = "latricia@thebrandrevivalist.com"
VITE_RECAPTCHA_SITE_KEY = "6LdYGJwtAAAAAMk_LjR-tzJniCr979cGSdptb0F-"

[nix]
channel = "stable-25_05"
